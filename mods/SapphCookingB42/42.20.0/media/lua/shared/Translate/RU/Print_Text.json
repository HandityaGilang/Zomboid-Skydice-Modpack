{
	"Print_Text_Fortune1_title": "Сообщение удачи",
	"Print_Text_Fortune1_info": "'Опыт - лучший учитель жизни.'",
	"Print_Text_Fortune2_title": "Сообщение удачи",
	"Print_Text_Fortune2_info": "'Живи этим днем, как если бы он был последним.'",
	"Print_Text_Fortune3_title": "Сообщение удачи",
	"Print_Text_Fortune3_info": "'В жизни нет сожалений. Есть только уроки.'",
	"Print_Text_Fortune4_title": "Сообщение удачи",
	"Print_Text_Fortune4_info": "'Позволь себе снова мечтать.'",
	"Print_Text_Fortune5_title": "Сообщение удачи",
	"Print_Text_Fortune5_info": "'Преврати свои раны в мудрость.'",
	"Print_Text_Fortune6_title": "Сообщение удачи",
	"Print_Text_Fortune6_info": "'Посмотри, как далеко ты зашел.'",
	"Print_Text_Fortune7_title": "Сообщение удачи",
	"Print_Text_Fortune7_info": "'Остерегайся Гоблинской собаки.'",
	"Print_Text_Fortune8_title": "Сообщение удачи",
	"Print_Text_Fortune8_info": "'Какой смысл в существовании, если ты не собой?'",
	"Print_Text_Fortune9_title": "Сообщение удачи",
	"Print_Text_Fortune9_info": "'Какой смысл в крыльях, если нет мужества летать.'",
	"Print_Text_Fortune10_title": "Сообщение удачи",
	"Print_Text_Fortune10_info": "'Маленькими шагами можно пройти большое расстояние.'"
}